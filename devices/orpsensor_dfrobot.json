{
  "category": "Chemistry Sensors",
  "predefined": true,
  "devices": [
    {
      "id": 150,
      "name": "DFRobot Analog ORP Sensor",
      "deviceClass": "orpsensor_dfrobot",
      "module": "./AnalogDevices",
      "readings": {
        "orp": {
          "label": "ORP",
          "interval": {
            "min": 2000,
            "max": 99000,
            "default": 10000
          }
        }
      },
      "outputs": [
        {
          "name": "orp",
          "desc": "ORP value in mV",
          "maxSamples": 50
        },
        {
          "name": "all",
          "desc": "All values",
          "maxSamples": 50
        }
      ],
      "options": [
        {
          "dataType": "panel",
          "field": {
            "type": "fieldset",
            "legend": "Calibration (Optional)",
            "style": {
              "marginTop": "1rem"
            }
          },
          "options": [
            {
              "field": {
                "type": "numberField",
                "binding": "options.orpOffset",
                "labelText": "ORP Offset (mV)",
                "units": "mV",
                "inputAttrs": {
                  "step": "1",
                  "min": "-1000",
                  "max": "1000"
                }
              }
            }
          ]
        }
      ],
      "interfaces": [
        "i2c"
      ]
    }
  ]
}