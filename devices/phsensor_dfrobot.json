{
  "category": "Chemistry Sensors",
  "predefined": true,
  "devices": [
    {
      "id": 100,
      "name": "DFRobot Analog pH Sensor",
      "deviceClass": "phsensor_dfrobot",
      "module": "./AnalogDevices",
      "readings": {
        "pH": {
          "label": "pH",
          "interval": {
            "min": 2000,
            "max": 99000,
            "default": 10000
          }
        }
      },
      "outputs": [
        {
          "name": "pH",
          "desc": "pH value",
          "maxSamples": 50
        },
        {
          "name": "all",
          "desc": "All values",
          "maxSamples": 50
        }
      ],
      "options": [
        {
          "dataType": "panel",
          "field": {
            "type": "fieldset",
            "legend": "Calibration",
            "style": {
              "marginTop": "1rem"
            }
          },
          "options": [
            {
              "field": {
                "type": "numberField",
                "binding": "options.neutralVoltage",
                "labelText": "Neutral Voltage (pH 7)",
                "units": "V",
                "inputAttrs": {
                  "step": "0.01",
                  "min": "0",
                  "max": "5"
                }
              }
            },
            {
              "field": {
                "type": "numberField",
                "binding": "options.acidVoltage",
                "labelText": "Acid Voltage (pH 4)",
                "units": "V",
                "inputAttrs": {
                  "step": "0.01",
                  "min": "0",
                  "max": "5"
                }
              }
            }
          ]
        },
        {
          "dataType": "panel",
          "field": {
            "type": "fieldset",
            "legend": "Interactive Calibration",
            "style": {
              "marginTop": "1rem"
            }
          },
          "options": [
            {
              "field": {
                "type": "actionButton",
                "text": "Set Neutral Voltage (pH 7)",
                "icon": "<i class=\"fas fa-tint\"></i>",
                "style": {
                  "width": "16rem"
                }
              },
              "fieldEvents": {
                "click": {
                  "type": "putservice",
                  "path": "`/config/i2c/${device.busNumber}/${device.address}/deviceCommand/setNeutral`",
                  "message": "Capturing neutral voltage..."
                }
              }
            },
            {
              "field": {
                "type": "actionButton",
                "text": "Set Acid Voltage (pH 4)",
                "icon": "<i class=\"fas fa-flask\"></i>",
                "style": {
                  "width": "16rem"
                }
              },
              "fieldEvents": {
                "click": {
                  "type": "putservice",
                  "path": "`/config/i2c/${device.busNumber}/${device.address}/deviceCommand/setAcid`",
                  "message": "Capturing acid voltage..."
                }
              }
            }
          ]
        }
      ],
      "interfaces": [
        "i2c"
      ]
    }
  ]
}